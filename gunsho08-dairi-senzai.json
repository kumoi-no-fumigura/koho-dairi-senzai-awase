 "poems": [
  {
   "seq": "1",
   "text": "君か爲花うへそむとつけねともちよまつ虫の音にそきこゆる",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "心してことしは匂へをみなへしさかぬはなそと人はいへとも",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "花をのみみるたにあるをのとかなる月さへそへる秋にまる哉",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "の花も色〓〓つきよとて野へのためしのかひも有けり",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "さきにほふ花のあたりの常よりもさやけかりける秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "野も山も心あるらしこよひより松のちとせを君にゆつりて",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "いつもさく花とはみれと白露のをきてかひあるけふと社みれ",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "色も香もこよひはまされ秋の花のとけき月のかけにみえつゝ",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "夜もすから月の光のさやけきにみれともあかぬ花の影かも",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "月影のいたらぬにはも今よひ社さやけかりけれ花のしら露",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "池水にかけのとかなる花みれはちるまつほとのたのもしき哉",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "ちゝの色の花のくさ〓〓月影ににほひそまさんよろつ代の秋",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "ちゝの秋かはらぬ花の匂ひをは月のひかりによるさへそみる",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "月かけに殘らぬ花の色はみな秋のにはからおへるなるへし",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "女郞花くらまの山のたねなれは人にこえたる色そみえける",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "年をへて咲けむよりもをみなへしけふより〓とに匂ひまさなん",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "月影のさやかならすは秋ふかみちくさににほふ花を見ましや",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "花も色も秋のよふかき月影に君か干とせをまつむしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "秋の花かさゝすにほふよろつ代をのとけき月の影に見るかな",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "うつろはめさかの色にて女郞花いくらはかりの秋をにほはん",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "女郞花にほへとあたに思はぬにのとけき月の影にかくれむ",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "萬代の秋にとにほふ花の色も心のとかに見ゆる月かな",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "花の色もことしはことに匂ひけりのとけき秋の月の影ゆへ",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "水の面に月さへすめる秋のよにのとけき花のかけをみるかな",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "吹風に思ひもよせし花すゝき君になひくとけふよりはしれ",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "うへてける花の匂のかひも有るかさやけき月に下枝みゆれは",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "もゝしきに萬の花をうつし植てやちよの秋のためしにそみる",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "九重に咲みたれたる花みれはちとせの秋は色もかはらし",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "九重にゝほひそめぬるをみなへし行さきまてもみゆるつき哉",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "秋の夜の花の色〓〓みゆるかな月のかつらも雲のうへにて",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "野邊よりはいかにか思花の色も月のかつらもにほひくらへて",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "秋のよの月のひかりのひとつにて草〓〓にほふ花のおりかな",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "秋の夜の月と花とをみるほとに鳴そふるかなすゝむしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "秋の空すめるこよひの月なれは花のひもとくかけも見えけり",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "月影のうすきこきをもてらす夜はいかてか花の色にわかまし",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "秋のよのつねよりあかき月影はのとかに花の色を見よとか",
   "kana": "",
   "speaker": "",
   "page": 616,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
